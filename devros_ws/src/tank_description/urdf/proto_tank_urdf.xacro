<?xml version="1.0" ?>
<robot name="tank_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="tank_description_share"
                  value="$(find tank_description)"/>

  <xacro:include filename="${tank_description_share}/urdf/tank.ros2_control.xacro"/>
  <xacro:include filename="${tank_description_share}/urdf/common_properties.xacro"/>
  <xacro:include filename="${tank_description_share}/urdf/proto_sensors.xacro"/>

  <xacro:property name="wheel_mass" value="0.3"/> 
  <xacro:property name="wheel_radius" value="0.033"/> 
  <xacro:property name="wheel_length" value="0.027"/> 

  <xacro:property name="base_mass" value="6"/> 
  <xacro:property name="base_radius" value="0.075"/> 
  <xacro:property name="base_length" value="0.19"/> 
 
  <xacro:property name="sup_mass" value="0.05"/> 
  <xacro:property name="sup_radius" value="0.02"/> 



<link name="base_footprint"/>

<joint name="base_footprint_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0.02" rpy="0 0 0"/>
</joint>


<link name="base_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 -${pi/2}"/>
    <geometry>
      <mesh filename="package://tank_description/meshes/proto_base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.07 0 0" rpy="0 0 -${pi/2}"/>
    <geometry>
      <mesh filename="package://tank_description/meshes/proto_base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  <xacro:cylinder_inertia m="${base_mass}" radius="${base_radius}" length="${base_length}" o_xyz="0.0 0.0 0.07" o_rpy="0 0 0"/>
</link>




<link name="right_back_wheel_link">
  <visual>
    <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    <geometry>
      <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
    </geometry>
    <material name="white"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    <geometry>
      <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
    </geometry>
  </collision>
  <xacro:sphere_inertia m="${wheel_mass}" radius="${wheel_radius}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0" />
</link>


<link name="left_back_wheel_link">
  <visual>
    <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    <geometry>
      <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
    </geometry>
    <material name="white"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    <geometry>
      <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
    </geometry>
  </collision>
  <xacro:sphere_inertia m="${wheel_mass}" radius="${wheel_radius}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0" />
</link>



<xacro:wheel_continuous_joint link_name="right_back_wheel_link" joint_name="right_back_wheel_joint"  o_xyz="0.0 ${base_radius/2 + wheel_length/2 + 0.01} 0.0" o_rpy="0 0 0"/>
<xacro:wheel_continuous_joint link_name="left_back_wheel_link" joint_name="left_back_wheel_joint"  o_xyz="0.0 -${base_radius/2 + wheel_length/2 + 0.01} 0.0" o_rpy="0 0 0"/>



<link name="sup_link_1">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="${sup_radius}"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="${sup_radius}"/>
    </geometry>
  </collision>
  <xacro:sphere_inertia m="${sup_mass}" radius="${sup_radius}" o_xyz="0 0 0" o_rpy="0 0 0" />
</link>


<joint name="sup_joint_1" type="fixed">
  <parent link="base_link"/>
  <child link="sup_link_1"/>
  <origin xyz="0.04 0 -0.015" rpy="0 0 0"/>
</joint>


<link name="sup_link_2">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="${sup_radius}"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="${sup_radius}"/>
    </geometry>
  </collision>
  <xacro:sphere_inertia m="${sup_mass}" radius="${sup_radius}" o_xyz="0 0 0" o_rpy="0 0 0" />
</link>


<joint name="sup_joint_2" type="fixed">
  <parent link="base_link"/>
  <child link="sup_link_2"/>
  <origin xyz="-0.04 0 -0.015" rpy="0 0 0"/>
</joint>

</robot>