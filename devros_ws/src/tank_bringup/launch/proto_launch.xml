<launch>
    <!-- <let name="urdf_path" 
    value="$(find-pkg-share tank_description/urdf/tank_urdf.xacro)"/> -->
   
   <let name="tank_description_share"
       value="$(find-pkg-share tank_description)" />

   <let name="tank_bringup_share"
       value="$(find-pkg-share tank_bringup)" />

   <let name="urdf_path"
       value="$(var tank_description_share)/urdf/proto_tank_urdf.xacro" />

  <let name="rviz_config_file_path" 
       value="$(var tank_description_share)/rviz/slam_config.rviz"/>
       
    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"/>
   
   <node pkg="robot_state_publisher" exec="robot_state_publisher">
   <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
   </node>


   <node pkg="rviz2" exec="rviz2" output="screen" 
          args="-d $(var rviz_config_file_path)"/>

</launch>